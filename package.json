{
  "name": "food-fight-26",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @foodfight/web --filter @foodfight/game-client --filter @foodfight/game-server --filter @foodfight/platform-api dev",
    "bots": "pnpm --filter @foodfight/bot-harness start",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "perf:budget": "pnpm --filter @foodfight/perf-budget check:client",
    "assets:audit": "pnpm --filter @foodfight/asset-audit run audit",
    "assets:derive:kaykit-pilot": "pnpm --filter @foodfight/asset-audit run derive:kaykit-pilot",
    "assets:derive:kenney-props": "pnpm --filter @foodfight/asset-audit run derive:kenney-props",
    "assets:derive:kenney-furniture": "pnpm --filter @foodfight/asset-audit run derive:kenney-furniture",
    "assets:derive:kenney-mini-market": "pnpm --filter @foodfight/asset-audit run derive:kenney-mini-market",
    "benchmark:room": "pnpm --filter @foodfight/load-benchmark start",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:m18": "node --test scripts/m18-report.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
